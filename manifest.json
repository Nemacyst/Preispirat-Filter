{
  "manifest_version": 3,
  "name": "Preispirat Filter",
  "version": "1.0",
  "description": "Blendet Beiträge bestimmter Nutzer auf preispirat.ch aus.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.preispirat.ch/*"],
  "icons": {
    "16": "preispirat-filter/preispirat-filter/icons/icon16.png",
    "48": "preispirat-filter/preispirat-filter/icons/icon48.png",
    "128": "preispirat-filter/preispirat-filter/icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.preispirat.ch/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Preispirat Filter",
    "default_icon": {
      "16": "preispirat-filter/preispirat-filter/icons/icon16.png",
      "48": "preispirat-filter/preispirat-filter/icons/icon48.png",
      "128": "preispirat-filter/preispirat-filter/icons/icon128.png"
    }
  }
}
